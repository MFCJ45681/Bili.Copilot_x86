<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BiliCopilot.PlayerEngine</RootNamespace>
    <AssemblyName>BiliCopilot.PlayerEngine</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Facade over the original Richasy.MpvKernel playback plugin (mpv engine).
         No custom source; the UI consumes Richasy.MpvKernel.* types transitively. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Richasy.MpvKernel" />
    <PackageReference Include="Richasy.MpvKernel.Core" />
    <PackageReference Include="Richasy.MpvKernel.Player" />
  </ItemGroup>
</Project>
